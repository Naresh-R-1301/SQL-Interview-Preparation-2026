-- 59 Find the number of employees in each department using COUNT().  
select department, count(*) number_of_employee from emp
group by Department;

-- 60 Find the average salary department-wise.  
select department , avg(salary) from emp
group by Department;

-- 61 Find the highest salary in each department.  
select department , max(salary) from emp
group by department;

-- 62 Find departments where the average salary exceeds 40,000.  
select department , avg(salary) from emp
group by department
having avg(Salary) > 40000;

-- 63 Find employees whose names contain exactly 5 characters.  
select * from emp
having length(first_name) = 5;

-- 64 Find employees whose names start with 'A' and end with 'n'.   
select * from emp
where first_name like'A%N';

-- 65 Find employees who have not been assigned a manager and belong to Chennai.
select * from emp
where Manager_ID is null 
and City ='Chennai';
  
 -- 66 Find employees whose salary is greater than the average salary of all employees.  
select * from emp
where salary > (select avg(Salary) from emp);

-- 67 Display the employee with the highest salary.  
select * from emp 
order by Salary desc
limit 1;

-- 68 Display the employee with the second-highest salary.
select * from emp
order by salary desc
limit 1 offset 1;






